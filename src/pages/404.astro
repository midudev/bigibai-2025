---
import PageLayout from '@/layouts/PageLayout.astro'
import SectionHeading from '@/components/ui/SectionHeading.astro'
import Button from '@/components/Button.astro'
import BrandLogo from '@/components/ui/BrandLogo.astro'
---

<PageLayout title="Página no encontrada | Big Ibai" width="reading">
  <div class="not-found">
    <BrandLogo variant="icon" width={50} />
    <SectionHeading
      as="h1"
      size="page"
      align="center"
      eyebrow="Error 404"
      title="Por aquí todavía no pasa la fábrica."
      description="No encontramos la página que buscas. Vuelve al inicio para descubrir el calendario y las novedades de Big Ibai."
    />
    <Button href="/" size="lg">
      Volver al inicio
    </Button>
  </div>
</PageLayout>
<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
    padding-block: 40px;
    text-align: center;
  }
</style>
