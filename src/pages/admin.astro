---
import PageLayout from '@/layouts/PageLayout.astro'
import AdminOverview from '@/components/admin/AdminOverview.astro'
import { supabaseAdmin } from '@/supabase-admin'
import { isAdmin } from '@/utils/admin'
import { CAMPAIGN } from '@/data/campaign'
import { TOTAL_COUPONS } from 'astro:env/server'

// Verificar que el usuario esté autenticado
if (!Astro.locals.user) {
  return Astro.redirect('/404')
}

// Verificar que el email del usuario esté en la lista de admins
const userId = Astro.locals.user.id
if (!isAdmin(userId)) {
  return Astro.redirect('/404')
}

// Obtener estadísticas generales en paralelo
const [
  { count: totalCouponsUsed },
  { data: uniqueUsersCount },
  { data: averageCouponsPerUser },
  { data: userCoupons },
] = await Promise.all([
  // 1. Total de cupones usados
  supabaseAdmin.from('coupons').select('*', { count: 'exact', head: true }).eq('is_used', true),

  // 2. Total de usuarios con cupones
  supabaseAdmin.rpc('total_unique_users_with_coupons'),

  // 3. Calcular media de cupones por usuario
  supabaseAdmin.rpc('avg_coupons_per_user'),

  // 4. Obtener cupones del usuario actual para el header
  supabaseAdmin
    .from('coupons')
    .select('used_at')
    .eq('used_by', Astro.locals.user.id)
    .eq('is_used', true),
])

const totalUserCoupons = userCoupons?.length || 0

// Calcular porcentaje de cupones reclamados
const totalCouponsAvailable = TOTAL_COUPONS
const claimedPercentage =
  totalCouponsAvailable > 0
    ? (((totalCouponsUsed || 0) / totalCouponsAvailable) * 100).toFixed(1)
    : '0.0'
---

<PageLayout title={`Administración | ${CAMPAIGN.name}`} participationCount={totalUserCoupons} noindex>
  <AdminOverview
    userName={Astro.locals.user.user_metadata.full_name || 'Administrador'}
    uniqueUsersCount={uniqueUsersCount ?? 0}
    totalCouponsUsed={totalCouponsUsed ?? 0}
    averageCouponsPerUser={Number(averageCouponsPerUser || 0)}
    claimedPercentage={claimedPercentage}
  />
</PageLayout>
