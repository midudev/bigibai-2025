---
import LegalLayout from '@/layouts/LegalLayout.astro'
import Notice from '@/components/ui/Notice.astro'
import BasesLegalesContent, { frontmatter } from '@/content/legal/bases-legales.md'
import { CAMPAIGN } from '@/data/campaign'
const isPreviousEdition = frontmatter.edition !== CAMPAIGN.year
---

<LegalLayout title="Bases legales">
  {isPreviousEdition && (
    <Notice slot="notice" variant="warning" class="mb-8">
      Estas son las bases legales de la edición {frontmatter.edition}. Las bases de {CAMPAIGN.name}{' '}
      se publicarán aquí antes de que se abra el registro de calendarios.
    </Notice>
  )}
  <BasesLegalesContent />
</LegalLayout>
