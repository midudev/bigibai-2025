---
import PageLayout from '@/layouts/PageLayout.astro'
import SectionHeading from '@/components/ui/SectionHeading.astro'
import WinnerCard from '@/components/ui/WinnerCard.astro'
import Notice from '@/components/ui/Notice.astro'
import { cells } from '@/data/days-data'
import { winners, WINNERS_YEAR } from '@/data/winners'

const winnersData = cells.map((cell) => {
  const winner = winners.find((w) => w.day === cell.day)
  return {
    ...cell,
    winnerEmail: winner ? winner.email : 'Próximamente',
    winnerName: winner ? winner.name : null,
  }
})
---

<PageLayout
  title={`Ganadores de ${WINNERS_YEAR} | Big Ibai`}
  description={`Consulta los ganadores de los sorteos del calendario de Adviento Big Ibai ${WINNERS_YEAR}, casilla a casilla.`}
>
  <SectionHeading
    as="h1"
    size="page"
    eyebrow={`Edición ${WINNERS_YEAR}`}
    title="La ilusión ya tiene ganadores."
    description="Consulta quién ganó cada uno de los sorteos del calendario de Adviento de esta edición."
  />
  <Notice class="winners-notice">
    Contactaremos con los ganadores por correo electrónico para coordinar la entrega de los premios.
  </Notice>
  <div class="winners-grid">
    {winnersData.map((data) => (
      <WinnerCard
        day={data.day}
        prize={data.gameData?.prize || 'Premio sorpresa'}
        name={data.winnerName}
        email={data.winnerEmail}
      />
    ))}
  </div>
</PageLayout>
<style>
  .winners-notice {
    margin-block: 30px 35px;
  }
  .winners-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }
  @media (max-width: 1000px) {
    .winners-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .winners-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
