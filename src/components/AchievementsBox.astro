---
import { ACHIEVEMENTS } from '@/data/achievements'
import Surface from '@/components/ui/Surface.astro'
import SectionHeading from '@/components/ui/SectionHeading.astro'
import Button from '@/components/Button.astro'
import { CAMPAIGN } from '@/data/campaign'
interface Props {
  embedded?: boolean
  isLoggedIn: boolean
  userAchievements: Record<string, { created_at: string }>
}
const { isLoggedIn, userAchievements, embedded = false } = Astro.props
const allAchievements = Object.values(ACHIEVEMENTS)
const unlockedCount = allAchievements.filter(({ id }) => !!userAchievements[id]).length
---

<Surface padded={!embedded} variant={embedded ? 'plain' : 'default'} class="achievements-box">
  <SectionHeading
    as="h2"
    size="small"
    title="Tus logros"
    description={
      isLoggedIn
        ? `${unlockedCount} de ${allAchievements.length} desbloqueados. Cada reto guarda una nueva historia.`
        : 'Inicia sesión para desbloquear y guardar tus logros.'
    }
  />
  <div class="achievements-grid">
    {allAchievements.map((achievement) => {
      const unlocked = !!userAchievements[achievement.id]
      return (
        <div
          class:list={['achievement-item', { 'is-locked': !unlocked }]}
          data-tip={unlocked ? achievement.descriptionDone : achievement.descriptionDo}
        >
          <img src={achievement.image} alt="" width="56" height="56" loading="lazy" />
          <p>{achievement.title}</p>
        </div>
      )
    })}
  </div>
  {!isLoggedIn && CAMPAIGN.signInEnabled && (
    <Button href="/registro" variant="outline" class="w-full" size="sm">
      Iniciar sesión
    </Button>
  )}
</Surface>
<style>
  .achievements-box :global(.ui-description) {
    font-size: 11px;
    margin-top: 10px;
  }
  .achievements-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 23px 10px;
    margin-block: 28px;
  }
  .achievement-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
  }
  .achievement-item img {
    width: 48px;
    height: 48px;
    object-fit: contain;
  }
  .achievement-item p {
    color: var(--text-copy);
    font-size: 10px;
    line-height: 1.6;
    text-wrap: balance;
  }
  .is-locked img {
    filter: grayscale(1);
    opacity: 0.45;
  }
  .is-locked p {
    color: var(--text-muted);
  }
</style>
