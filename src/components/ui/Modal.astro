---
interface Props {
  id: string
  titleId: string
  closeId?: string
}
const { id, titleId, closeId } = Astro.props
---

<dialog id={id} class="ui-dialog" aria-labelledby={titleId}>
  <div class="ui-modal-panel">
    <button
      id={closeId}
      class="ui-modal-close"
      type="button"
      data-dialog-close
      aria-label="Cerrar ventana"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <path d="m6 6 12 12M6 18 18 6" />
      </svg>
    </button>
    <slot />
  </div>
</dialog>
<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLDialogElement>('.ui-dialog').forEach((dialog) => {
      if (dialog.dataset.ready) return
      dialog.dataset.ready = 'true'
      dialog.querySelector('[data-dialog-close]')?.addEventListener('click', () => dialog.close())
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close()
      })
    })
  })
</script>
<style>
  .ui-dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 20px;
    border: 0;
    background: transparent;
    overflow: auto;
  }
  .ui-dialog[open] {
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }
  .ui-modal-panel {
    margin-block: auto;
  }
  .ui-dialog::backdrop {
    background: #030c22b3;
    backdrop-filter: blur(5px);
  }
  :global(html:has(.ui-dialog[open])) {
    overflow: hidden;
  }
</style>
