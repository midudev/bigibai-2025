---
import type { HTMLAttributes } from 'astro/types'
interface Props extends HTMLAttributes<'span'> {
  tone?: 'brand' | 'muted' | 'info' | 'warning' | 'success' | 'error'
  class?: string
}
const { tone = 'muted', class: className, ...rest } = Astro.props
---

<span class:list={['ui-badge', `ui-badge--${tone}`, className]} {...rest}>
  <slot />
</span>
