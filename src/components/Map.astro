---
import { CAMPAIGN } from '@/data/campaign'
import Surface from '@/components/ui/Surface.astro'
import Badge from '@/components/ui/Badge.astro'

interface Props {
  edition?: number
}

const { edition = CAMPAIGN.year } = Astro.props
const cf = (Astro.request as Request & { cf?: { latitude?: string; longitude?: string } }).cf
const latitude = Number(cf?.latitude)
const longitude = Number(cf?.longitude)
const hasUserLocation =
  Number.isFinite(latitude) &&
  Number.isFinite(longitude) &&
  Math.abs(latitude) <= 90 &&
  Math.abs(longitude) <= 180
const centerLat = hasUserLocation ? latitude : 41.390205
const centerLon = hasUserLocation ? longitude : 2.154007
const retailers = [
  { name: 'Eroski', color: '#fb923c' },
  { name: 'El Corte Inglés', color: '#34d399' },
  { name: 'Carrefour', color: '#7aa7ff' },
  { name: 'Alcampo', color: '#fb7185' },
]
---

<Surface as="section" class="store-locator" aria-labelledby="map-title">
  <div class="locator-heading">
    <div>
      <h3 id="map-title">Encuentra tu tienda</h3>
      <p>Acércate en el mapa y selecciona un punto para ver la dirección.</p>
    </div>
    <Badge class="locator-edition">Edición {edition}</Badge>
  </div>
  <div class="map-stage">
    <div
      id="map"
      role="region"
      aria-label="Mapa interactivo de tiendas Big Ibai"
      aria-describedby="map-help"
      data-has-user-location={hasUserLocation}
      data-center-lat={centerLat}
      data-center-lon={centerLon}
      data-initial-zoom="11"
    ></div>
    <p id="map-status" class="map-status" role="status">
      Cargando tiendas…
    </p>
  </div>
  <div class="locator-footer">
    <ul class="retailer-legend" aria-label="Supermercados y colores de sus marcadores">
      {retailers.map(({ name, color }) => (
        <li>
          <span style={{ backgroundColor: color }} aria-hidden="true"></span>
          {name}
        </li>
      ))}
    </ul>
    <p id="map-help">Los números agrupan tiendas cercanas.</p>
  </div>
  {edition !== CAMPAIGN.year && (
    <p class="locator-note">
      Ubicaciones de {edition}. La disponibilidad de la edición {CAMPAIGN.year} se confirmará
      próximamente.
    </p>
  )}
</Surface>

<!-- Leaflet CSS -->
<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>

<!-- MapLibre GL, para el fondo vectorial de OpenFreeMap (sin API key) -->
<link
  rel="stylesheet"
  href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css"
  integrity="sha256-V2sIX92Uh6ZaGSFTKMHghsB85b9toJtmazgG09AI2uk="
  crossorigin=""
/>

<!-- Leaflet JS -->
<script
  is:inline
  src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
  crossorigin=""
></script>

<script
  is:inline
  src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"
  integrity="sha256-vpYzxNhw4m+zfxz+XFp3GBZnEUAD6hYgeseFDY2ordE="
  crossorigin=""
></script>
<script
  is:inline
  src="https://unpkg.com/@maplibre/maplibre-gl-leaflet@0.1.4/leaflet-maplibre-gl.js"
  integrity="sha256-Hmz4yz61/ZCYeaob82o4P7UGyaWy27+rq85lopTdH8s="
  crossorigin=""
></script>

<!-- Supercluster: índice espacial. Solo se crean marcadores para lo que está en pantalla. -->
<script
  is:inline
  src="https://unpkg.com/supercluster@8.0.1/dist/supercluster.min.js"
  integrity="sha256-WYH7OWQn2QUK5DCjUNPmF1szrNa7FSNxP6RXtco0EdQ="
  crossorigin=""
></script>

<script>
  const L = window.L

  // Variables globales que se inicializan solo si el mapa existe
  let $map: HTMLDivElement | null = null
  let centerLat: string | undefined
  let centerLon: string | undefined
  let initialZoom: string | undefined
  let hasUserLocation = false

  // Diccionario de retail
  const retailDictionary: Record<string, string> = {
    A: 'Eroski',
    B: 'El Corte Inglés',
    C: 'Carrefour',
    D: 'Alcampo',
  } as const

  const colors: Record<string, string> = {
    A: '#fb923c',
    B: '#34d399',
    C: '#7aa7ff',
    D: '#fb7185',
  }

  function getColorForRetail(retail: string): string {
    return colors[retail] || '#b1c3dd'
  }

  // Función para obtener el nombre del retail
  function getRetailName(retail: string): string {
    return retailDictionary[retail] || retail
  }

  type Store = {
    lat: number
    lon: number
    ciudad?: string
    provincia?: string
    direccion?: string
    retail: string
  }

  // Radio en píxeles de pantalla. extent 256 alinea el cálculo con las teselas de Leaflet.
  const CLUSTER_RADIUS = 60
  const CLUSTER_MAX_ZOOM = 19
  const POPUP_OPTIONS = { maxWidth: 300, className: 'custom-popup' }

  let locations: Store[] = []
  let clusterIndex: any = null
  let locationsPromise: Promise<Store[]> | null = null
  let activeMap: any = null
  let generation = 0
  let scheduledFrame = 0

  const storeIcons = new Map<string, any>()
  const clusterIcons = new Map<number, any>()

  function escapeHtml(value: string): string {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
  }

  function storePopupHtml(location: Store): string {
    const retailName = escapeHtml(getRetailName(location.retail))
    const address = escapeHtml(location.direccion || 'Consulta la dirección en el mapa')
    const place = [location.ciudad, location.provincia]
      .filter(Boolean)
      .filter((value, index, values) => values.indexOf(value) === index)
      .map((value) => escapeHtml(value!))
      .join(', ')
    const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${location.lat},${location.lon}`)}`

    return `<div class="store-popup">
      <p class="store-popup-name"><span style="background:${getColorForRetail(location.retail)}" aria-hidden="true"></span>${retailName}</p>
      <p class="store-popup-address">${address}</p>
      ${place ? `<p class="store-popup-place">${place}</p>` : ''}
      <a class="store-popup-directions" href="${mapsUrl}" target="_blank" rel="noopener noreferrer">Cómo llegar<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg></a>
    </div>`
  }

  function storeIcon(retail: string) {
    const key = colors[retail] ? retail : 'default'
    const cached = storeIcons.get(key)
    if (cached) return cached
    const icon = L.divIcon({
      html: `<span class="store-dot" style="--store-color:${getColorForRetail(retail)}"></span>`,
      iconSize: [28, 28],
      iconAnchor: [14, 14],
      popupAnchor: [0, -13],
      className: 'store-marker',
    })
    storeIcons.set(key, icon)
    return icon
  }

  function clusterIcon(count: number) {
    const cached = clusterIcons.get(count)
    if (cached) return cached
    const size = count < 10 ? 32 : count < 100 ? 36 : 40
    const icon = L.divIcon({
      html: `<span class="store-cluster">${count}</span>`,
      className: 'store-cluster-marker',
      iconSize: [size, size],
      iconAnchor: [size / 2, size / 2],
      popupAnchor: [0, -size / 2],
    })
    clusterIcons.set(count, icon)
    return icon
  }

  const BASE_MAP_STYLE = 'https://tiles.openfreemap.org/styles/fiord'
  let mapStylePromise: Promise<any> | null = null

  function loadMapStyle() {
    if (!mapStylePromise) {
      mapStylePromise = fetch(BASE_MAP_STYLE)
        .then((response) => {
          if (!response.ok) throw new Error('No se pudo cargar el fondo del mapa')
          return response.json()
        })
        .then((style) => {
          const css = getComputedStyle(document.documentElement)
          const color = (name: string) => css.getPropertyValue(name).trim()
          for (const layer of style.layers) {
            const source = layer['source-layer']
            const paint = (layer.paint ??= {})
            if (layer.type === 'background') paint['background-color'] = color('--map-land')
            if (layer.type === 'fill') {
              paint['fill-color'] =
                source === 'water'
                  ? color('--map-water')
                  : source === 'building'
                    ? color('--map-building')
                    : source === 'park' || source === 'landcover'
                      ? color('--map-park')
                      : color('--map-residential')
            }
            if (layer.type === 'line') {
              paint['line-color'] =
                source === 'boundary'
                  ? color('--map-boundary')
                  : source === 'waterway'
                    ? color('--map-water')
                    : layer.id.includes('casing')
                      ? color('--map-road-edge')
                      : color('--map-road')
              if (source === 'boundary') paint['line-opacity'] = 0.4
            }
            if (layer.type === 'symbol') {
              paint['text-color'] = source === 'place' ? '#c2cfe1' : '#91a7c2'
              paint['text-halo-color'] = color('--map-land')
              paint['text-halo-width'] = 1.5
              paint['text-halo-blur'] = 0
              layer.layout ??= {}
              layer.layout['text-transform'] = 'none'
            }
          }
          return style
        })
        .catch(() => BASE_MAP_STYLE)
    }
    return mapStylePromise
  }

  function loadLocations(): Promise<Store[]> {
    if (!locationsPromise) {
      locationsPromise = fetch('/api/locations')
        .then((response) => {
          if (!response.ok) throw new Error('No se pudieron cargar las tiendas')
          return response.json()
        })
        .then((data) => {
          if (!Array.isArray(data)) throw new Error('Formato de tiendas no válido')
          return data as Store[]
        })
        .catch((error) => {
          locationsPromise = null
          throw error
        })
    }
    return locationsPromise
  }

  function ensureClusterIndex() {
    if (clusterIndex) return clusterIndex
    const Supercluster = window.Supercluster
    if (!Supercluster) throw new Error('Supercluster no está disponible')

    const points = []
    for (let i = 0; i < locations.length; i++) {
      const location = locations[i]
      const lat = Number(location.lat)
      const lon = Number(location.lon)
      if (!Number.isFinite(lat) || !Number.isFinite(lon)) continue
      points.push({
        type: 'Feature',
        properties: { i },
        geometry: { type: 'Point', coordinates: [lon, lat] },
      })
    }

    clusterIndex = new Supercluster({
      radius: CLUSTER_RADIUS,
      extent: 256,
      maxZoom: CLUSTER_MAX_ZOOM,
      minPoints: 2,
    })
    clusterIndex.load(points)
    return clusterIndex
  }

  function destroyMap() {
    generation++
    if (scheduledFrame) {
      cancelAnimationFrame(scheduledFrame)
      scheduledFrame = 0
    }
    if (activeMap) {
      activeMap.remove()
      activeMap = null
    }
  }

  document.addEventListener('astro:before-swap', destroyMap)

  document.addEventListener('astro:page-load', () => {
    const container = document.querySelector<HTMLDivElement>('#map')
    if (!container) return

    const details = container.closest('details')
    const initialize = () => {
      if (!container.isConnected) return
      if (details && !details.open) {
        // Cerrar el mapa libera el contexto WebGL y los marcadores.
        if (container.dataset.mapReady === '1') {
          destroyMap()
          delete container.dataset.mapReady
        }
        return
      }
      if (container.dataset.mapReady === '1') {
        activeMap?.invalidateSize()
        return
      }

      $map = container
      container.dataset.mapReady = '1'
      centerLat = container.dataset.centerLat
      centerLon = container.dataset.centerLon
      initialZoom = container.dataset.initialZoom
      hasUserLocation = container.dataset.hasUserLocation === 'true'

      // El mapa cerrado no solicita las tiendas ni crea una superficie de tamaño cero.
      loadLocations().catch(() => {})
      initMap(container)
    }

    details?.addEventListener('toggle', initialize)
    initialize()
  })

  async function initMap(container: HTMLDivElement) {
    const gen = ++generation

    try {
      const lat = Number(centerLat)
      const lon = Number(centerLon)
      const zoom = Number(initialZoom)

      // El fondo se pinta ya. Las tiendas llegan después y no bloquean el mapa.
      const map = L.map(container, {
        maxZoom: CLUSTER_MAX_ZOOM,
        minZoom: 4,
        zoomControl: false,
        scrollWheelZoom: false,
      }).setView([lat, lon], zoom)
      activeMap = map
      map.attributionControl.setPrefix('')
      L.control
        .zoom({ position: 'bottomright', zoomInTitle: 'Acercar', zoomOutTitle: 'Alejar' })
        .addTo(map)

      void loadMapStyle().then((style) => {
        if (gen !== generation || activeMap !== map) return
        L.maplibreGL({ style, attributionControl: false }).addTo(map)
      })
      map.attributionControl.addAttribution(
        '<a href="https://openfreemap.org" target="_blank" rel="noopener">OpenFreeMap</a> &copy; <a href="https://www.openmaptiles.org/" target="_blank" rel="noopener">OpenMapTiles</a> &copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>'
      )

      if (hasUserLocation) {
        const userIcon = L.divIcon({
          html: '<span class="approximate-location"></span>',
          iconSize: [16, 16],
          iconAnchor: [8, 8],
          className: 'user-location-marker',
        })
        L.marker([lat, lon], { icon: userIcon, title: 'Zona aproximada por IP' })
          .addTo(map)
          .bindPopup('Zona aproximada por IP', { className: 'store-location-popup' })
      }

      locations = await loadLocations()
      if (gen !== generation || activeMap !== map) return

      const index = ensureClusterIndex()
      const layer = L.layerGroup().addTo(map)
      const visible = new Map<string, any>()

      const popupOptions = POPUP_OPTIONS

      function openClusterPopup(marker: any, clusterId: number, total: number) {
        const leaves = index.getLeaves(clusterId, 12)
        const cards = leaves
          .map((leaf: { properties: { i: number } }) =>
            storePopupHtml(locations[leaf.properties.i])
          )
          .join('<hr class="store-popup-divider">')
        const more =
          total > leaves.length
            ? `<p class="store-popup-more">Y ${total - leaves.length} tiendas más en este punto.</p>`
            : ''
        marker.bindPopup(cards + more, popupOptions).openPopup()
      }

      function renderViewport() {
        if (gen !== generation || activeMap !== map) return

        const bounds = map.getBounds().pad(0.2)
        const zoomLevel = Math.max(0, Math.min(CLUSTER_MAX_ZOOM, Math.round(map.getZoom())))
        // Al dar la vuelta al mundo Leaflet usa longitudes fuera de ±180. Se consulta cada copia del mundo visible.
        const west = bounds.getWest()
        const east = bounds.getEast()
        const firstCopy = Math.floor((west + 180) / 360)
        const lastCopy = Math.floor((east + 180) / 360)
        const features: { feature: any; shift: number }[] = []
        for (let copy = firstCopy; copy <= lastCopy; copy++) {
          const shift = copy * 360
          const found = index.getClusters(
            [Math.max(west - shift, -180), bounds.getSouth(), Math.min(east - shift, 180), bounds.getNorth()],
            zoomLevel
          )
          for (const feature of found) features.push({ feature, shift })
        }

        const seen = new Set<string>()
        for (let n = 0; n < features.length; n++) {
          const { feature, shift } = features[n]
          const [baseLon, featureLat] = feature.geometry.coordinates
          const featureLon = baseLon + shift
          const props = feature.properties
          const isCluster = props.cluster === true
          const id = `${shift}${isCluster ? `c${props.cluster_id}` : `p${props.i}`}`
          seen.add(id)
          if (visible.has(id)) continue

          const marker = isCluster
            ? L.marker([featureLat, featureLon], {
                icon: clusterIcon(props.point_count),
                title: `${props.point_count} tiendas. Acercar el mapa.`,
              })
            : L.marker([featureLat, featureLon], {
                icon: storeIcon(locations[props.i].retail),
                title: `${getRetailName(locations[props.i].retail)}: ${locations[props.i].direccion || 'Ver tienda'}`,
              })
          marker.on('add', () => {
            marker.getElement()?.setAttribute('aria-label', marker.options.title)
          })

          if (isCluster) {
            const clusterId = props.cluster_id
            const count = props.point_count
            marker.on('click', () => {
              const nextZoom = index.getClusterExpansionZoom(clusterId)
              if (nextZoom > map.getZoom() && map.getZoom() < map.getMaxZoom()) {
                map.flyTo([featureLat, featureLon], Math.min(nextZoom, map.getMaxZoom()), {
                  animate: !matchMedia('(prefers-reduced-motion: reduce)').matches,
                })
                return
              }
              openClusterPopup(marker, clusterId, count)
            })
          } else {
            const storeIndex = props.i
            marker.bindPopup(() => storePopupHtml(locations[storeIndex]), popupOptions)
          }

          marker.addTo(layer)
          visible.set(id, marker)
        }

        for (const [id, marker] of visible) {
          if (seen.has(id)) continue
          layer.removeLayer(marker)
          visible.delete(id)
        }
      }

      function requestRender() {
        if (scheduledFrame) return
        scheduledFrame = requestAnimationFrame(() => {
          scheduledFrame = 0
          renderViewport()
        })
      }

      renderViewport()
      container.dataset.state = 'ready'
      const status = document.getElementById('map-status')
      if (status) status.hidden = true
      map.on('moveend', requestRender)
    } catch (error) {
      if (gen !== generation || !container.isConnected) return
      container.dataset.state = 'error'
      const status = document.getElementById('map-status')
      if (status) {
        status.hidden = false
        status.textContent =
          'No se han podido cargar las tiendas. Recarga la página para intentarlo de nuevo.'
      }
      console.error('Error al inicializar el mapa.', error)
    }
  }
</script>

<style>
  .store-locator {
    overflow: hidden;
    color: var(--text-heading);
    font-family: var(--font-body);
  }
  .locator-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 25px 28px;
  }
  .locator-heading h3 {
    margin: 0;
    color: var(--text-heading);
    font-size: 17px;
    font-weight: bold;
    line-height: 1.4;
  }
  .locator-heading p {
    margin-top: 6px;
    color: var(--text-muted);
    font-size: 11px;
    line-height: 1.8;
  }
  .locator-edition {
    flex-shrink: 0;
    padding: 6px 10px;
    border: 1px solid color-mix(in srgb, var(--text-muted) 18.04%, transparent);
    border-radius: 6px;
    color: var(--text-muted);
    font-size: 10px;
    white-space: nowrap;
  }
  .map-stage {
    position: relative;
  }
  #map {
    width: 100%;
    height: 450px;
    border-block: 1px solid color-mix(in srgb, var(--text-muted) 18.04%, transparent);
    background: var(--map-land);
  }
  .map-status {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 500;
    max-width: calc(100% - 32px);
    padding: 10px 14px;
    border: 1px solid color-mix(in srgb, var(--text-muted) 25.1%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--surface) 94.9%, transparent);
    color: var(--text-copy);
    font-size: 11px;
    line-height: 1.6;
  }
  .locator-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
    padding: 21px 28px;
  }
  .retailer-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 25px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .retailer-legend li {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-copy);
    font-size: 11px;
    white-space: nowrap;
  }
  .retailer-legend li > span {
    flex-shrink: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }
  #map-help {
    color: var(--text-muted);
    font-size: 10px;
    line-height: 1.7;
  }
  .locator-note {
    margin: 0 28px;
    padding: 15px 0 18px;
    border-top: 1px solid color-mix(in srgb, var(--text-muted) 12.16%, transparent);
    color: var(--text-muted);
    font-size: 10px;
    line-height: 1.8;
  }
  :global(#map .leaflet-control-zoom) {
    margin: 0 16px 22px 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--text-muted) 34.9%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--surface) 94.9%, transparent);
    box-shadow: 0 2px 8px #03132d33;
  }
  :global(#map .leaflet-control-zoom a) {
    width: 36px;
    height: 36px;
    border: 0;
    background: transparent;
    color: var(--text-heading);
    font-family: var(--font-body);
    font-size: 22px;
    line-height: 36px;
  }
  :global(#map .leaflet-control-zoom a + a) {
    border-top: 1px solid color-mix(in srgb, var(--text-muted) 18.04%, transparent);
  }
  :global(#map .leaflet-control-zoom a:hover) {
    background: #203858;
    color: var(--brand-accent);
  }
  :global(#map .leaflet-control-zoom a.leaflet-disabled) {
    color: #7384a1;
  }
  :global(#map .leaflet-control-attribution) {
    padding: 2px 7px;
    background: color-mix(in srgb, var(--surface) 90.2%, transparent);
    color: var(--text-muted);
    font:
      9px/1.7 'Century',
      sans-serif;
  }
  :global(#map .leaflet-control-attribution a) {
    color: var(--text-muted);
  }
  :global(#map .leaflet-control-attribution a:hover) {
    color: var(--text-heading);
    text-decoration: underline;
  }
  :global(#map .store-marker),
  :global(#map .store-cluster-marker),
  :global(#map .user-location-marker) {
    background: transparent;
    border: 0;
    font-family: var(--font-body);
  }
  :global(#map .store-dot) {
    display: block;
    width: 16px;
    height: 16px;
    margin: 6px;
    border: 2px solid var(--text-heading);
    border-radius: 50%;
    background: var(--store-color);
    box-shadow: 0 0 0 3px var(--surface);
    transition: transform 0.15s;
  }
  :global(#map .store-marker:hover .store-dot) {
    transform: scale(1.15);
  }
  :global(#map .store-cluster) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border: 1px solid color-mix(in srgb, var(--brand-accent) 60%, transparent);
    border-radius: 50%;
    background: #102443;
    color: #ffd18a;
    font-size: 12px;
    font-weight: bold;
    line-height: 1;
    box-shadow: 0 2px 4px #03132d33;
