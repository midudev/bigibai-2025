---
import Button from './Button.astro'
---

<div class="back-to-home">
  <Button href="/" variant="ghost" size="sm">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      aria-hidden="true"
    >
      <path d="m15 18-6-6 6-6" />
    </svg>
    Volver al inicio
  </Button>
</div>
<style>
  .back-to-home {
    margin-bottom: 28px;
  }
  .back-to-home :global(.ui-button) {
    padding-left: 0;
  }
</style>
