---
import { CAMPAIGN, NOTICES } from '@/data/campaign'
import { formatCampaignDate, getCampaignPhase } from '@/utils/campaign'
import SectionHeading from '@/components/ui/SectionHeading.astro'
import Notice from '@/components/ui/Notice.astro'
interface Props {
  prize: string
}
const { prize } = Astro.props
const { winnersPublishedAt, registrationClosesAt } = CAMPAIGN
const isRegistrationOpen = getCampaignPhase(Astro.locals.now) === 'registration'
---

<div id="game-success-content" class="hidden game-success">
  <SectionHeading
    as="h2"
    size="section"
    eyebrow="Reto completado"
    title="Sorpresa revelada."
    description="El premio que se sortea en esta casilla es:"
  />
  <p class="revealed-prize">{prize}</p>
  <Notice variant="warning" title={NOTICES.prizeIsNotWon}>
    {winnersPublishedAt
      ? `Los ganadores se anunciarán el ${formatCampaignDate(winnersPublishedAt)}.`
      : 'Los ganadores se anunciarán según las bases legales de la promoción.'}
    {isRegistrationOpen && registrationClosesAt && (
      <p>
        Recuerda registrar tu calendario antes del {formatCampaignDate(registrationClosesAt)} para
        participar.
      </p>
    )}
  </Notice>
</div>
<style>
  .game-success {
    padding-block: 20px;
  }
  .game-success :global(.ui-heading) {
    font-size: 32px;
  }
  .revealed-prize {
    margin-block: 25px;
    color: var(--brand-accent);
    font-size: 23px;
    font-weight: bold;
    line-height: 1.5;
    text-wrap: balance;
  }
</style>
