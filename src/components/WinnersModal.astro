---
import Button from './Button.astro'
import Modal from '@/components/ui/Modal.astro'
import BrandLogo from '@/components/ui/BrandLogo.astro'
import SectionHeading from '@/components/ui/SectionHeading.astro'
import { CAMPAIGN } from '@/data/campaign'
---

<Modal id="winners-modal" titleId="winners-modal-title" closeId="close-winners-modal">
  <div class="announcement">
    <BrandLogo variant="factory" width={200} />
    <SectionHeading
      as="h2"
      id="winners-modal-title"
      title="La ilusión ya tiene ganadores."
      description={`Los resultados del calendario de Adviento ${CAMPAIGN.name} ya están disponibles. Consulta la lista para descubrir a los ganadores.`}
    />
    <Button href="/ganadores" size="lg" class="w-full">
      Ver los ganadores
    </Button>
  </div>
</Modal>
<style>
  .announcement {
    display: grid;
    gap: 28px;
    padding-top: 10px;
  }
  .announcement :global(.ui-heading) {
    font-size: 34px;
  }
  .announcement :global(.ui-description) {
    font-size: 13px;
  }
</style>
<script>
  document.addEventListener('astro:page-load', () => {
    const modal = document.querySelector<HTMLDialogElement>('#winners-modal')
    if (modal && location.pathname !== '/ganadores' && !modal.open) modal.showModal()
  })
</script>
