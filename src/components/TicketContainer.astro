---
import Surface from '@/components/ui/Surface.astro'
import { getCampaignPhase } from '@/utils/campaign'
interface Props {
  totalCoupons: number
}
const { totalCoupons } = Astro.props
const phase = getCampaignPhase(Astro.locals.now)
const hint =
  phase === 'registration'
    ? 'Registra otro calendario para sumar una nueva participación.'
    : phase === 'upcoming'
      ? 'El registro de calendarios abrirá muy pronto.'
      : 'El plazo para registrar calendarios ha finalizado. ¡Gracias por participar!'
---

<Surface as="article" padded class="ticket-card" aria-labelledby="participation-status">
  <div class="ticket-symbol" aria-hidden="true">
    <svg
      width="28"
      height="28"
      viewBox="0 0 40 40"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <path d="M5 10h30v7a4 4 0 0 0 0 8v5H5v-5a4 4 0 0 0 0-8zM26 10v5m0 3v5m0 3v4" />
    </svg>
  </div>
  <div id="ticket-content">
    <h2 id="participation-status">Tus participaciones</h2>
    <p class="ticket-total" aria-live="polite">
      <strong id="ticket-coupon-count">{totalCoupons}</strong>
      <span id="ticket-coupon-text">
        {totalCoupons === 1 ? 'participación' : 'participaciones'}
      </span>
    </p>
    <p class="ticket-hint">{hint}</p>
  </div>
</Surface>
<style>
  .ticket-card {
    display: flex;
    align-items: start;
    gap: 22px;
  }
  .ticket-symbol {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-control);
    color: var(--brand-accent);
    flex-shrink: 0;
  }
  h2 {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: bold;
    color: var(--text-heading);
  }
  .ticket-total {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-top: 12px;
    color: var(--text-copy);
    font-size: 13px;
  }
  .ticket-total strong {
    font-family: var(--font-display);
    font-size: 46px;
    font-weight: normal;
    line-height: 1;
    color: var(--brand-accent);
  }
  .ticket-hint {
    margin-top: 15px;
    font-size: 11px;
    line-height: 1.9;
    color: var(--text-muted);
  }
  @media (max-width: 400px) {
    .ticket-card {
      gap: 15px;
    }
    .ticket-symbol {
      width: 40px;
      height: 40px;
    }
    .ticket-total {
      gap: 8px;
      font-size: 11px;
    }
  }
</style>
