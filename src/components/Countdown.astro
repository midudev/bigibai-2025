---
interface Props {
  day: number
  title?: string
  // Instante de desbloqueo y hora del servidor (real o simulada) en ISO
  unlockAt: string
  serverNow: string
  isSimulatedDate?: boolean
}

const { day, title, unlockAt, serverNow, isSimulatedDate = false } = Astro.props
---

<div class="countdown-panel" role="timer" aria-label={`Cuenta atrás para la casilla ${day}`}>
  <p>La puerta se abre en</p>
  <span id="countdown">Calculando…</span>
  <p>El {day} de diciembre, a las 00:00 h (hora peninsular).</p>
</div>
<style>
  .countdown-panel {
    width: 100%;
    padding: 24px 18px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-control);
    background: var(--surface-inset);
    text-align: center;
  }
  .countdown-panel p {
    font-size: 11px;
    line-height: 1.8;
    color: var(--text-muted);
  }
  #countdown {
    display: block;
    margin-block: 12px;
    font-family: var(--font-display);
    font-size: clamp(26px, 4vw, 44px);
    color: var(--brand-accent);
    line-height: 1.3;
  }
</style>

<script define:vars={{ unlockAt, serverNow, isSimulatedDate }}>
  const countdownElement = document.getElementById('countdown')
  const targetTime = new Date(unlockAt).getTime()

  // Contamos desde la hora del servidor para no depender del reloj del dispositivo
  const clockOffset = new Date(serverNow).getTime() - Date.now()

  let interval

  const updateCountdown = () => {
    // Con el ClientRouter el intervalo sobrevive a la navegación: paramos si ya no estamos aquí
    if (!countdownElement?.isConnected) {
      clearInterval(interval)
      return
    }

    const diffMs = targetTime - (Date.now() + clockOffset)

    if (diffMs <= 0) {
      countdownElement.textContent = '00d 00h 00m 00s'
      clearInterval(interval)

      // La casilla ya se ha desbloqueado: recargamos para que el servidor la sirva.
      // Con fecha simulada el servidor no avanza, así que recargar volvería a la cuenta atrás
      if (!isSimulatedDate) location.reload()
      return
    }

    const seconds = Math.floor(diffMs / 1000)
    const days = Math.floor(seconds / 86400)
    const hours = Math.floor((seconds % 86400) / 3600)
    const minutes = Math.floor((seconds % 3600) / 60)
    const secs = seconds % 60

    countdownElement.textContent = `${days}d ${hours
      .toString()
      .padStart(2, '0')}h ${minutes.toString().padStart(2, '0')}m ${secs
      .toString()
      .padStart(2, '0')}s`
  }

  interval = setInterval(updateCountdown, 1000)
  updateCountdown()
</script>
