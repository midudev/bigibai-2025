---
import Button from './Button.astro'
import Modal from '@/components/ui/Modal.astro'
import BrandLogo from '@/components/ui/BrandLogo.astro'
import SectionHeading from '@/components/ui/SectionHeading.astro'
---

<Modal id="deadline-modal" titleId="deadline-modal-title" closeId="close-deadline-modal">
  <div class="announcement">
    <BrandLogo variant="factory" width={200} />
    <SectionHeading
      as="h2"
      id="deadline-modal-title"
      title="El registro ha finalizado."
      description="El plazo para registrar calendarios ha terminado. Puedes consultar tus participaciones en tu cuenta y las fechas de los resultados en las bases legales."
    />
    <Button id="btn-close-deadline" size="lg" class="w-full">
      Entendido
    </Button>
  </div>
</Modal>
<style>
  .announcement {
    display: grid;
    gap: 28px;
    padding-top: 10px;
  }
  .announcement :global(.ui-heading) {
    font-size: 34px;
  }
  .announcement :global(.ui-description) {
    font-size: 13px;
  }
</style>
<script>
  document.addEventListener('astro:page-load', () => {
    const modal = document.querySelector<HTMLDialogElement>('#deadline-modal')
    if (!modal) return
    if (!sessionStorage.getItem('deadline-modal-closed') && !modal.open) modal.showModal()
    modal.querySelector('#btn-close-deadline')?.addEventListener('click', () => modal.close())
    modal.addEventListener('close', () => sessionStorage.setItem('deadline-modal-closed', 'true'))
  })
</script>
