---
import Button from '@/components/Button.astro'
import FactoryLogo from '@/components/ui/FactoryLogo.astro'
import ChocolateBox from '@/components/ChocolateBox.astro'
import { CAMPAIGN } from '@/data/campaign'
interface Props {
  campaignCopy: { title: string; text: string; href: string; cta: string; note: string }
  calendarProgress: { value: number; label: string } | null
  highlights: { value: number; label: string }[]
}
const { campaignCopy, calendarProgress, highlights } = Astro.props
---

<section class="factory-hero site-container site-container--wide" aria-labelledby="factory-title">
  <div class="hero-copy">
    <h1 id="factory-title">
      <FactoryLogo />
    </h1>
    <p class="hero-headline">{campaignCopy.title}</p>
    <p class="hero-description">{campaignCopy.text}</p>
    <div class="hero-actions">
      <Button size="lg" href={campaignCopy.href}>
        {campaignCopy.cta}
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </Button>
      <a class="ui-text-link" href="#como-participar">
        Cómo funciona
      </a>
    </div>
    <div class="hero-details">
      {calendarProgress && (
        <p class="hero-progress">
          <strong>{calendarProgress.value}</strong>
          <span>{calendarProgress.label}</span>
        </p>
      )}
      <p class="hero-note">{campaignCopy.note}</p>
    </div>
  </div>
  <div class="hero-art">
    <ChocolateBox />
    <div class="edition-stamp">
      <span>Nueva edición</span>
      <strong>2026</strong>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="m12 0 2.7 9.3L24 12l-9.3 2.7L12 24l-2.7-9.3L0 12l9.3-2.7Z" />
      </svg>
    </div>
  </div>
</section>

<ul class="factory-strip" aria-label={`Big Ibai ${CAMPAIGN.year} en cifras`}>
  {highlights.map(({ value, label }) => (
    <li>
      <strong>{value}</strong> {label}
    </li>
  ))}
</ul>

<style>
  .factory-hero {
    overflow-x: clip;
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    gap: 25px;
    width: min(var(--content-wide), calc(100% - var(--page-gutter) * 2));
    min-height: 690px;
    margin: auto;
    padding: 44px 0 68px;
  }
  .hero-copy {
    position: relative;
    z-index: 2;
    padding: 0 0 0 32px;
  }
  h1 {
    width: min(100%, 570px);
    margin: 0 0 30px -6px;
  }
  .hero-headline {
    color: var(--text-heading);
    max-width: 480px;
    font-size: clamp(21px, 2.05vw, 28px);
    font-weight: bold;
    line-height: 1.35;
    text-wrap: balance;
  }
  .hero-description {
    max-width: 420px;
    margin-top: 16px;
    color: var(--text-copy);
    font-size: 15px;
    line-height: 1.8;
    text-wrap: pretty;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 26px;
    margin-top: 28px;
  }
  .hero-details {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-top: 33px;
    padding-top: 22px;
    border-top: 1px solid color-mix(in srgb, var(--text-heading) 12.55%, transparent);
    width: fit-content;
    color: var(--text-copy);
    font-size: 14px;
    line-height: 1.55;
    text-align: left;
  }
  .hero-details > * + * {
    border-left: 1px solid color-mix(in srgb, var(--text-heading) 14.9%, transparent);
    padding-left: 24px;
  }
  .hero-progress {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .hero-progress strong {
    color: var(--brand-accent);
    font-size: 44px;
    line-height: 1;
  }
  .hero-progress span {
    max-width: 150px;
  }
  .hero-note {
    max-width: 260px;
  }
  .hero-art {
    position: relative;
    align-self: center;
    display: flex;
    justify-content: center;
    padding: 3px 24px 0;
  }
  .edition-stamp {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    right: 14px;
    bottom: 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 116px;
    height: 116px;
    border-radius: 50%;
    border: 1px solid #ffcf71;
    background: var(--brand-accent);
    color: var(--brand-ink);
    transform: rotate(10deg);
    box-shadow: 0 8px 25px #0005;
    transition:
      transform 450ms ease,
      width 450ms ease,
      height 450ms ease;
  }
  .hero-art:has(chocolate-box[data-open='true']) .edition-stamp {
    transform: translateY(40px) rotate(10deg) scale(0.85);
  }
  .edition-stamp span {
    font-size: 10px;
    font-weight: bold;
  }
  .edition-stamp strong {
    font-family: var(--font-display);
    font-weight: normal;
    font-size: 36px;
    line-height: 1.3;
  }
  .edition-stamp svg {
    margin-top: 2px;
  }
  .factory-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 30px;
    width: 100%;
    padding: 18px var(--page-gutter);
    border-block: 1px solid color-mix(in srgb, var(--brand-accent) 31.37%, transparent);
    background: color-mix(in srgb, var(--surface-inset) 46.67%, transparent);
    white-space: nowrap;
  }
  .factory-strip li {
    display: flex;
    align-items: baseline;
    gap: 8px;
    color: var(--text-heading);
    font-family: var(--font-display);
    font-size: 19px;
  }
  .factory-strip li + li::before {
    content: '✦';
    margin-right: 22px;
    color: var(--brand-accent);
    font-family: sans-serif;
    font-size: 14px;
  }
  .factory-strip strong {
    color: var(--brand-accent);
    font-size: 26px;
    font-weight: normal;
    line-height: 1;
  }
  @media (min-width: 1500px) {
    .factory-hero {
      padding-block: 55px 78px;
      min-height: 750px;
    }
  }
  @media (max-width: 1050px) {
    .factory-hero {
      width: calc(100% - var(--page-gutter) * 2);
    }
    .hero-copy {
      padding-left: 0;
    }
    .factory-hero {
      min-height: 615px;
      gap: 15px;
    }
    .hero-art {
      padding-inline: 15px;
    }
    .hero-headline {
      font-size: 22px;
    }
    .hero-description {
      font-size: 13px;
    }
    .hero-actions {
      gap: 18px;
    }
    .hero-details {
      gap: 18px;
      font-size: 13px;
    }
    .hero-details > * + * {
      padding-left: 18px;
    }
    .edition-stamp {
      width: 96px;
      height: 96px;
      right: 14px;
    }
    .edition-stamp strong {
      font-size: 30px;
    }
    .edition-stamp span {
      font-size: 9px;
    }
  }
  @media (max-width: 760px) {
    .factory-hero {
      grid-template-columns: 1fr;
      width: calc(100% - var(--page-gutter) * 2);
      gap: 34px;
      padding-block: 35px 40px;
    }
    .hero-copy {
      text-align: center;
    }
    h1 {
      width: min(100%, 490px);
      margin: 0 auto 24px;
    }
    .hero-headline {
      margin-inline: auto;
      font-size: 23px;
    }
    .hero-description {
      max-width: 420px;
      margin-inline: auto;
      margin-top: 13px;
      font-size: 13px;
      line-height: 1.85;
    }
    .hero-actions {
      justify-content: center;
      gap: 22px;
      margin-top: 23px;
    }
    .hero-details {
      margin: 24px auto 0;
      gap: 14px;
      padding-top: 17px;
    }
    .hero-details > * + * {
      padding-left: 14px;
    }
    .hero-details {
      font-size: 12px;
    }
    .hero-progress {
      flex-shrink: 0;
    }
    .hero-progress span {
      max-width: 118px;
    }
    .hero-progress strong {
      font-size: 36px;
    }
    .hero-art {
      width: min(100%, 440px);
      padding: 0 20px;
      justify-self: center;
    }
    .edition-stamp {
      right: 12px;
      bottom: 25px;
      width: 91px;
      height: 91px;
    }
    .edition-stamp span {
      font-size: 8px;
    }
    .edition-stamp strong {
      font-size: 30px;
    }
    .edition-stamp svg {
      width: 14px;
      height: 14px;
    }
    .hero-art:has(chocolate-box[data-open='true']) .edition-stamp {
      width: 70px;
      height: 70px;
      bottom: 15px;
      right: 12px;
      transform: rotate(10deg);
    }
    .hero-art:has(chocolate-box[data-open='true']) .edition-stamp strong {
      font-size: 24px;
    }
    .hero-art:has(chocolate-box[data-open='true']) .edition-stamp span {
      font-size: 7px;
    }
    .factory-strip {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px 16px;
      padding-block: 16px;
    }
    .factory-strip li {
      justify-content: center;
      font-size: 15px;
    }
    .factory-strip li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
    .factory-strip li + li::before {
      display: none;
    }
    .factory-strip strong {
      font-size: 21px;
    }
  }
  @media (max-width: 370px) {
    .hero-details {
      gap: 12px;
      font-size: 11px;
    }
    .hero-details > * + * {
      padding-left: 12px;
    }
    .hero-actions {
      gap: 14px;
    }
  }
</style>
