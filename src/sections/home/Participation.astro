---
import Container from '@/components/ui/Container.astro'
import SectionHeading from '@/components/ui/SectionHeading.astro'
import Notice from '@/components/ui/Notice.astro'
import { NOTICES } from '@/data/campaign'
import { getCampaignPhase } from '@/utils/campaign'
interface Props {
  isLoggedIn: boolean
}
const { isLoggedIn } = Astro.props
const phase = getCampaignPhase(Astro.locals.now)

// Chocolatinas que salen de la casilla en la ilustración del tercer paso
const doorChocolates = [
  { day: 4, width: 116, x: '-58px', rotate: '-14deg', delay: '0s' },
  { day: 2, width: 97, x: '0px', rotate: '0deg', delay: '-1.2s' },
  { day: 9, width: 106, x: '58px', rotate: '12deg', delay: '-2.4s' },
]
---

<Container
  as="section"
  id="como-participar"
  class="participation-section"
  aria-labelledby="participation-title"
>
  <div class="section-heading">
    <SectionHeading as="h2" id="participation-title" eyebrow="La puerta de entrada a la fábrica">
      <Fragment slot="title">
        Todo empieza con
        <br />
        un calendario.
      </Fragment>
    </SectionHeading>
    <p>Chocolate, sorpresas y un plan para cada día. Así se vive el diciembre de Big Ibai.</p>
  </div>
  <ol class="participation-steps">
    <li class="step">
      <div class="step-scene" aria-hidden="true">
        <div class="scene-art scene-art--box">
          <div class="calendar-box">
            <img
              src="/2026/fabrica-small.webp"
              width="600"
              height="788"
              alt=""
              loading="lazy"
              decoding="async"
            />
          </div>
          <span class="box-sticker">
            <strong>24</strong>
            chocolatinas
          </span>
        </div>
        <span class="step-number">01</span>
      </div>
      <h3>Consigue tu calendario</h3>
      <p>El universo de Ibai, convertido en un calendario de Adviento con 24 chocolatinas.</p>
      <a class="step-link" href="#tiendas">
        Dónde encontrarlo
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M12 5v14m-6-6 6 6 6-6" />
        </svg>
      </a>
    </li>
    <li class="step">
      <div class="step-scene" aria-hidden="true">
        <div class="scene-art scene-art--code">
          <div class="code-ticket">
            <div class="ticket-paper">
              <span class="ticket-stub">
                <span class="ticket-face"></span>
              </span>
              <span class="ticket-label">Tu código</span>
              <span class="ticket-code">K7Q9·X2FM</span>
            </div>
            <span class="ticket-check">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
              >
                <path d="m5 12 5 5 9-10" />
              </svg>
            </span>
          </div>
        </div>
        <span class="step-number">02</span>
      </div>
      <h3>Registra tu código</h3>
      <p>Inicia sesión e introduce el código de tu calendario para participar en los sorteos.</p>
      {phase === 'registration' ? (
        <a class="step-link" href={isLoggedIn ? '/dashboard' : '/registro'}>
          Registrar mi código
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M5 12h14m-6-6 6 6-6 6" />
          </svg>
        </a>
      ) : (
        <span class="step-status">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
          </svg>
          {phase === 'upcoming'
            ? 'El registro se abrirá próximamente'
            : 'El registro ha finalizado'}
        </span>
      )}
    </li>
    <li class="step step--final">
      <div class="step-scene" aria-hidden="true">
        <div class="scene-art scene-art--door">
          <div class="door-chocolates">
            {doorChocolates.map(({ day, width, x, rotate, delay }) => (
              <img
                class="door-chocolate"
                src={`/2026/chocolates/${day}.webp`}
                width={width}
                height="190"
                alt=""
                loading="lazy"
                decoding="async"
                style={`--x: ${x}; --rotate: ${rotate}; --delay: ${delay}`}
              />
            ))}
          </div>
          <div class="mini-door">
            <span class="mini-door-leaf">24</span>
          </div>
        </div>
        <span class="step-number">03</span>
      </div>
      <h3>Abre la ilusión cada día</h3>
      <p>
        Del 1 al 24 de diciembre, descubre las casillas y diviértete con los juegos de la fábrica.
      </p>
      <a class="step-link" href="#calendario">
        Ver las 24 casillas
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M12 5v14m-6-6 6 6 6-6" />
        </svg>
      </a>
    </li>
  </ol>
  <Notice class="steps-notice">{NOTICES.gamesAreOptional}</Notice>
</Container>

<style>
  .participation-section {
    --steps-gap: clamp(16px, 2vw, 28px);
    --scene-height: 230px;
    --number-size: 64px;
    padding-block: 90px 75px;
  }
  .section-heading {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--steps-gap);
    align-items: end;
    margin-bottom: 48px;
  }
  .section-heading > :global(.ui-heading-group) {
    grid-column: span 2;
  }
  .section-heading > p {
    max-width: 34ch;
    padding-bottom: 6px;
    color: var(--text-copy);
    font-size: 15px;
    line-height: 1.8;
    text-wrap: pretty;
  }
  .participation-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: auto auto 1fr auto;
    gap: 0 var(--steps-gap);
    list-style: none;
    padding: 0;
  }
  /* Cada paso es una tarjeta con su ilustración; el subgrid alinea títulos y enlaces entre ellas */
  .step {
    position: relative;
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    padding: 10px 10px 26px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-panel);
    background: linear-gradient(
      180deg,
      var(--surface-raised),
      color-mix(in srgb, var(--surface) 70%, transparent)
    );
    transition:
      translate 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.3s;
  }
  .step > :not(.step-scene) {
    margin-inline: 16px;
  }
  .step--final {
    border-color: color-mix(in srgb, var(--brand-accent) 45%, transparent);
  }
  .step-scene {
    position: relative;
    margin-bottom: calc(var(--number-size) / 2 + 22px);
  }
  .scene-art {
    position: relative;
    display: grid;
    place-items: center;
    height: var(--scene-height);
    border-radius: calc(var(--radius-panel) - 6px);
    overflow: hidden;
    background:
      radial-gradient(#ffffff1f 1px, transparent 1.5px) 0 0 / 18px 18px,
      radial-gradient(circle at 50% 70%, var(--scene-glow), transparent 62%),
      linear-gradient(160deg, var(--scene-top), var(--surface-inset));
  }
  .step-number {
    position: absolute;
    left: 16px;
    bottom: calc(var(--number-size) / -2);
    display: grid;
    place-items: center;
    width: var(--number-size);
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--brand-accent) 50%, transparent);
    border-radius: var(--radius-control);
    background: var(--surface-raised);
    color: var(--brand-accent);
    font-family: var(--font-display);
    font-size: 28px;
    line-height: 1;
    box-shadow: 0 4px 0 #050f26;
  }
  .step--final .step-number {
    border-color: #ffd786;
    background: var(--brand-accent);
    color: var(--brand-ink);
    box-shadow: 0 4px 0 var(--brand-edge);
  }

  /* 01 · La caja del calendario */
  .scene-art--box {
    --scene-glow: #4f8cff73;
    --scene-top: #18407f;
  }
  .calendar-box {
    position: relative;
    width: 122px;
    aspect-ratio: 600 / 788;
    margin-top: 14px;
    border-radius: 6px;
    overflow: hidden;
    box-shadow:
      8px 10px 0 #06122bb3,
      0 22px 40px #0009;
    rotate: -7deg;
    transition:
      rotate 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
      scale 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .calendar-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .calendar-box::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, #ffffff40, transparent 38%);
  }
  .box-sticker {
    position: absolute;
    top: 28px;
    left: calc(50% + 34px);
    display: grid;
    place-items: center;
    align-content: center;
    width: 76px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--brand-accent);
    color: var(--brand-ink);
    font-size: 9px;
    font-weight: bold;
    line-height: 1.1;
    box-shadow: 0 3px 0 var(--brand-edge);
    rotate: 12deg;
  }
  .box-sticker strong {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: normal;
  }

  /* 02 · El ticket con el código */
  .scene-art--code {
    --scene-glow: #7b5cff66;
    --scene-top: #2a2f78;
  }
  .code-ticket {
    position: relative;
    width: min(82%, 260px);
    filter: drop-shadow(0 5px 0 var(--brand-edge)) drop-shadow(0 18px 22px #0007);
    rotate: -5deg;
    transition: rotate 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .ticket-paper {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: 14px;
    padding: 18px 20px;
    border-radius: 12px;
    background: linear-gradient(135deg, #ffd98f, var(--brand-accent) 55%, #e89b23);
    color: var(--brand-ink);
    /* Muescas laterales de ticket */
    mask:
      radial-gradient(circle 11px at 0 50%, #0000 98%, #000) left / 51% 100% no-repeat,
      radial-gradient(circle 11px at 100% 50%, #0000 98%, #000) right / 51% 100% no-repeat;
  }
  .ticket-stub {
    grid-row: span 2;
    padding-right: 14px;
    border-right: 2px dashed color-mix(in srgb, var(--brand-ink) 35%, transparent);
  }
  .ticket-face {
    display: block;
    width: 34px;
    aspect-ratio: 368.5 / 489.4;
    background: var(--brand-ink);
    mask: url('/2026/ibai.svg') center / contain no-repeat;
  }
  .ticket-label {
    align-self: end;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .ticket-code {
    align-self: start;
    font-family: var(--font-display);
    font-size: 23px;
    line-height: 1.25;
    white-space: nowrap;
  }
  .ticket-code::after {
    content: '';
    display: inline-block;
    width: 2px;
    height: 0.9em;
    margin-left: 3px;
    vertical-align: -0.1em;
    background: currentColor;
  }
  .ticket-check {
    position: absolute;
    top: -12px;
    right: -10px;
    display: grid;
    place-items: center;
    width: 34px;
    aspect-ratio: 1;
    border: 3px solid var(--surface-raised);
    border-radius: 50%;
    background: var(--status-success);
    color: var(--brand-ink);
  }

  /* 03 · La casilla abierta con chocolatinas */
  .scene-art--door {
    --scene-glow: #f8b13266;
    --scene-top: #2b2c6e;
    --door-top: 100px;
    --chocolate-size: 96px;
  }
  .door-chocolates {
    position: absolute;
    left: 50%;
    bottom: var(--door-top);
    z-index: 1;
  }
  .door-chocolate {
    position: absolute;
    bottom: 0;
    left: var(--x);
    width: auto;
    max-width: none;
    height: var(--chocolate-size);
    translate: -50% 0;
    rotate: var(--rotate);
    filter: drop-shadow(0 8px 10px #0008);
    transition: scale 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .door-chocolate:nth-child(2) {
    z-index: 1;
    height: calc(var(--chocolate-size) * 1.2);
  }
  .mini-door {
    position: absolute;
    bottom: 16px;
    left: 50%;
    width: 120px;
    height: calc(var(--door-top) - 16px);
    translate: -50% 0;
    border: 2px solid color-mix(in srgb, var(--brand-accent) 70%, transparent);
    border-radius: 10px;
    background: radial-gradient(circle at 50% 20%, #fff3cf, var(--brand-accent) 45%, #a8661a);
    box-shadow: 0 0 40px #f8b13299;
    perspective: 420px;
  }
  .mini-door-leaf {
    position: absolute;
    inset: -2px;
    display: grid;
    place-items: center;
    border: 2px solid color-mix(in srgb, var(--brand-accent) 70%, transparent);
    border-radius: 10px;
    background: var(--surface-raised);
    color: var(--brand-accent);
    font-family: var(--font-display);
    font-size: 38px;
    transform-origin: left center;
    transform: rotateY(-62deg);
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .step h3 {
    margin-bottom: 10px;
    color: var(--text-heading);
    font-size: 21px;
    font-weight: bold;
    line-height: 1.35;
  }
  .step p {
    max-width: 36ch;
    color: var(--text-copy);
    font-size: 14px;
    line-height: 1.8;
    text-wrap: pretty;
  }
  .step-link,
  .step-status {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    font-size: 13px;
  }
  .step-link {
    min-height: 44px;
    color: var(--brand-accent);
    font-weight: bold;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--brand-accent) 35%, transparent);
    text-underline-offset: 6px;
    transition: text-decoration-color 0.15s;
  }
  .step-link:hover {
    text-decoration-color: currentColor;
  }
  .step-status {
    align-self: center;
    padding: 8px 12px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-control);
    background: var(--surface-inset);
    color: var(--text-muted);
    font-size: 12px;
    line-height: 1.4;
  }
  .step-status svg {
    flex-shrink: 0;
  }
  /* El aviso de los juegos va justo debajo del paso que habla de ellos */
  .steps-notice {
    width: calc((100% - var(--steps-gap) * 2) / 3);
    margin: 16px 0 0 auto;
    padding: 0 27px;
    border: 0;
    background: none;
    font-size: 13px;
    line-height: 1.6;
  }

  @media (hover: hover) {
    .step:hover {
      translate: 0 -4px;
      border-color: var(--border-strong);
    }
    .step--final:hover {
      border-color: var(--brand-accent);
    }
    .step:hover .calendar-box {
      rotate: -2deg;
      scale: 1.05;
    }
    .step:hover .code-ticket {
      rotate: 0deg;
    }
    .step:hover .door-chocolate {
      scale: 1.08;
    }
    .step:hover .mini-door-leaf {
      transform: rotateY(-75deg);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .door-chocolate {
      animation: chocolate-float 3.6s ease-in-out var(--delay) infinite alternate;
    }
    .ticket-code::after {
      animation: caret-blink 1.1s steps(1) infinite;
    }
  }
  @keyframes chocolate-float {
    to {
      translate: -50% -8px;
    }
  }
  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 1050px) {
    .participation-section {
      --scene-height: 200px;
      --number-size: 56px;
    }
    .step-number {
      font-size: 24px;
    }
    .step h3 {
      font-size: 18px;
    }
    .calendar-box {
      width: 108px;
    }
    .box-sticker {
      left: calc(50% + 26px);
      width: 66px;
    }
    .box-sticker strong {
      font-size: 24px;
    }
    .ticket-code {
      font-size: 19px;
    }
    .scene-art--door {
      --door-top: 92px;
      --chocolate-size: 82px;
    }
  }
  @media (max-width: 760px) {
    .participation-section {
      --scene-height: 210px;
      padding-block: 58px 45px;
    }
    .section-heading {
      display: block;
      margin-bottom: 32px;
    }
    .section-heading > p {
      margin-top: 18px;
      font-size: 14px;
    }
    .participation-steps {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }
    .step {
      display: block;
    }
    .step p {
      max-width: none;
    }
    .steps-notice {
      width: auto;
      margin-top: 14px;
    }
    .ticket-code {
      font-size: 22px;
    }
  }
</style>
