---
import Surface from '@/components/ui/Surface.astro'
import { WINNERS_YEAR } from '@/data/winners'
import { getCampaignPhase } from '@/utils/campaign'
interface Props {
  campaignCopy: { status: string; note: string }
}
const { campaignCopy } = Astro.props
const phase = getCampaignPhase(Astro.locals.now)
---

<Surface as="section" class="campaign-status site-container" aria-labelledby="status-title">
  <img src="/2026/ibai.svg" width="45" height="60" alt="" loading="lazy" />
  <div>
    <h2 id="status-title">{campaignCopy.status}</h2>
    <p>
      {phase === 'upcoming'
        ? 'Las fechas, los premios y las bases de esta edición se publicarán antes de abrir el registro.'
        : campaignCopy.note}
    </p>
  </div>
  <a class="ui-text-link" href={phase === 'upcoming' ? '/ganadores' : '/bases-legales'}>
    {phase === 'upcoming' ? `Ganadores de ${WINNERS_YEAR}` : 'Consultar las bases'}
    <span aria-hidden="true">↗</span>
  </a>
</Surface>

<style>
  .campaign-status {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-bottom: 65px;
    padding: 28px 32px;
  }
  .campaign-status > img {
    width: 35px;
    height: auto;
  }
  .campaign-status > div {
    flex: 1;
  }
  .campaign-status h2 {
    font-family: var(--font-body);
    font-weight: bold;
    font-size: 16px;
  }
  .campaign-status p {
    margin-top: 8px;
    color: var(--text-copy);
    font-size: 11px;
    line-height: 1.8;
  }
  .campaign-status .ui-text-link {
    color: var(--brand-accent);
    flex-shrink: 0;
    font-size: 11px;
  }
  @media (max-width: 760px) {
    .campaign-status {
      flex-wrap: wrap;
      gap: 17px;
      padding: 23px 20px;
      margin-bottom: 40px;
    }
    .campaign-status > img {
      width: 28px;
    }
    .campaign-status > div {
      flex-basis: calc(100% - 50px);
    }
    .campaign-status h2 {
      font-size: 14px;
    }
    .campaign-status p {
      font-size: 10px;
    }
    .campaign-status .ui-text-link {
      margin-left: 45px;
      font-size: 10px;
    }
  }
</style>
