---
import { CAMPAIGN } from '@/data/campaign'
import { getCampaignDay, isExperienceEnabled } from '@/utils/campaign'
import AdventBoard from '@/components/AdventBoard.astro'
import Button from '@/components/Button.astro'
import SectionHeading from '@/components/ui/SectionHeading.astro'
const { now } = Astro.locals
const experienceEnabled = isExperienceEnabled(now)
const currentDay = getCampaignDay(now)
const openedDays = experienceEnabled ? currentDay : 0
---

<section id="calendario" class="advent-section" aria-labelledby="advent-title">
  <div class="advent-copy">
    <SectionHeading
      as="h2"
      id="advent-title"
      eyebrow={`Del 1 al 24 de diciembre de ${CAMPAIGN.year}`}
    >
      <Fragment slot="title">
        24 días.
        <br />
        Una puerta
        <br />
        a la ilusión.
      </Fragment>
    </SectionHeading>
    <p class="advent-description">
      Cada día, una nueva casilla.
      <br />
      ¿Qué habrá al otro lado?
    </p>
    <div class="advent-progress">
      <span
        class="progress-ring"
        style={`--progress: ${openedDays / CAMPAIGN.totalDays}`}
        aria-hidden="true"
      >
        <strong>{openedDays}</strong>
      </span>
      <p>
        <span class="progress-label">
          {openedDays === 1 ? 'puerta abierta' : 'puertas abiertas'} de {CAMPAIGN.totalDays}
        </span>
        <span class="progress-status">
          {!experienceEnabled
            ? 'La experiencia ha finalizado'
            : currentDay === 0
              ? 'La primera, el 1 de diciembre'
              : currentDay === CAMPAIGN.totalDays
                ? '¡Hoy se abre la última!'
                : `Mañana, la ${currentDay + 1}`}
        </span>
      </p>
    </div>
    {experienceEnabled && currentDay > 0 && (
      <Button size="lg" href={`/casilla-${currentDay}-diciembre`}>
        Abrir la puerta de hoy
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </Button>
    )}
    <p class="advent-note">
      Se abren a las 00:00 h, hora peninsular española. Los juegos son opcionales.
    </p>
  </div>
  <AdventBoard />
</section>
<style>
  .advent-section {
    display: grid;
    grid-template-columns: minmax(240px, 300px) minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 4vw, 64px);
    scroll-margin-top: 32px;
    color: var(--text-heading);
  }
  .advent-copy {
    display: grid;
    justify-items: start;
    gap: 26px;
  }
  .advent-copy :global(.ui-heading) {
    font-size: clamp(30px, 3vw, 40px);
  }
  .advent-description {
    color: var(--text-copy);
    font-size: 15px;
    line-height: 1.7;
    text-wrap: pretty;
  }
  /* Progreso en un anillo que se va llenando con cada puerta que se abre */
  .advent-progress {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    padding-block: 22px;
    border-block: 1px solid var(--border-subtle);
  }
  .progress-ring {
    position: relative;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 68px;
    aspect-ratio: 1;
  }
  .progress-ring::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(
      var(--brand-accent) calc(var(--progress) * 1turn),
      color-mix(in srgb, var(--text-muted) 20%, transparent) 0
    );
    mask: radial-gradient(circle, #0000 calc(50% - 5px), #000 calc(50% - 4px));
  }
  .progress-ring strong {
    position: relative;
    color: var(--brand-accent);
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: normal;
    line-height: 1;
  }
  .advent-progress p {
    display: grid;
    gap: 4px;
  }
  .progress-label {
    color: var(--text-heading);
    font-size: 15px;
    font-weight: bold;
  }
  .progress-status {
    color: var(--status-warning);
    font-size: 13px;
  }
  .advent-note {
    color: var(--text-muted);
    font-size: 12px;
    line-height: 1.7;
  }
  @media (max-width: 1050px) {
    .advent-section {
      grid-template-columns: 1fr;
    }
    .advent-copy {
      max-width: 420px;
    }
  }
  @media (max-width: 760px) {
    .advent-copy {
      gap: 22px;
    }
    .advent-description {
      font-size: 14px;
    }
  }
</style>
